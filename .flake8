[flake8]
convention = google
inline-quotes = "
max-line-length = 100
max-complexity = 18
ignore =
    E203,
    E266,
    F401,
    W503,
    N807,
    N818,
    D100,
    D104,
    D105,
    D106,
    D107
select = B,C,D,E,F,W,T4,B9,Q0,N8,VNE
exclude =
    **migrations
    venv
    .venv

per-file-ignores =
    __init__.py: F401
    tests/*: D101, D102, D103
